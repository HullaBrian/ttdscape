{
  "name": "ttdscape",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local, interactive 3D explorer of a process's heap, virtual memory and API calls over time, from Microsoft TTD traces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HullaBrian/ttdscape.git"
  },
  "homepage": "https://github.com/HullaBrian/ttdscape#readme",
  "bugs": "https://github.com/HullaBrian/ttdscape/issues",
  "keywords": ["time-travel-debugging", "ttd", "windows", "heap", "memory", "malware-analysis", "capa", "three.js"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "node server/index.mjs",
    "test": "node --test \"tests/client/*.test.mjs\" \"tests/server/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\""
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "7.3.1"
  }
}
